# Скопируйте этот файл в .env и подставьте реальные значения.

# Обязателен. Сгенерировать новый:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True только для локальной разработки. На боевом сервере — False.
DEBUG=False

# Через запятую, без пробелов.
ALLOWED_HOSTS=127.0.0.1

# redis://redis:6379/0 — если запускаете через docker-compose (там есть сервис redis).
# redis://localhost:6379/0 — если Redis запущен локально, вне docker-compose.
CELERY_BROKER_URL=redis://localhost:6379/0

# Обязательны, без значений по умолчанию.
POSTGRES_DB=review_parser
POSTGRES_USER=review_parser
POSTGRES_PASSWORD=change-me

# По умолчанию рассчитаны на docker-compose (там сервис называется postgres).
# Для запуска вне docker-compose поставьте POSTGRES_HOST=localhost.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Ключ для 2GIS Public API. Без него парсинг 2GIS работать не будет.
TWOGIS_API_KEY=

# Ключ для YouTube Data API v3 (Google Cloud Console). Без него парсинг YouTube-плейлистов работать не будет.
YOUTUBE_API_KEY=
